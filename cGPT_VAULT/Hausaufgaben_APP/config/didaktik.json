{
  "version": "1.0",
  "context": "HEBOTUTOR_DIDAKTIK",
  "description": "Zentrale didaktische Matrix für den HEBO Hausaufgaben-Tutor. Verknüpft Klassenstufe (grade_level) und Schulart (school_type) mit Tiefe, Sprache und Beispieltyp.",

  "dimensions": {
    "grade_level": [
      "basis",
      "mittel_1",
      "mittel_2",
      "oberstufe"
